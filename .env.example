MARKETAUX_API_KEY=
FINNHUB_API_KEY=
NEWSDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_CONTACT_EMAIL=
# Neon DIRECT (non-pooled) connection string, must end with ?sslmode=require
DATABASE_URL=
TEST_DATABASE_URL=
# Read-only login `finsight_agents` (created by: python dev.py agents-role); direct, sslmode=require
AGENTS_DATABASE_URL=
AGENTS_TEST_DATABASE_URL=

# Models
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
FINBERT_MODEL_NAME=ProsusAI/finbert
NER_MODEL_NAME=dslim/bert-base-NER

# Scheduler / pipeline
SCHEDULER_INTERVAL_MINUTES=30
ADVISORY_LOCK_KEY=487219
EMBED_MAX_ATTEMPTS=5
RAW_PAYLOAD_RETENTION_DAYS=7
DB_SIZE_WARN_MB=800

# Agents service (services/agents)
AGENTS_LLM_PROVIDER=gemini            # gemini | anthropic (no automatic fallback)
AGENTS_GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AGENTS_LLM_MODEL=                     # per-stock calls (no default)
AGENTS_SYNTH_LLM_MODEL=               # the single final synthesis call (no default)
AGENTS_LLM_RPM=10
AGENTS_LLM_MAX_CALLS_PER_RUN=8
NEWS_WINDOW_DAYS=30
SENTIMENT_MIN_ARTICLES=3
SECTOR_MIN_ARTICLES=5
SHARED_CLAUSE_WEIGHT=0.5
SECTOR_PROVIDER=tkg_lite              # tkg_lite | tkg
