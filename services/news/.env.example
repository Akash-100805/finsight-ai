# ============================================================
# FinSight Data Pipeline — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── News API Keys ────────────────────────────────────────────
MARKETAUX_API_KEY=your_marketaux_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
# GDELT requires no API key (public endpoint)

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/finsight

# ── Test Database (separate, created fresh per test run) ─────
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/finsight_test

# ── Embedding (Phase 10) ─────────────────────────────────────
# DESIGN DECISION PENDING: embedding model choice (see DESIGN_DECISIONS.md)
# Options: openai/text-embedding-3-small (1536-dim), openai/text-embedding-ada-002 (1536-dim),
#          BAAI/bge-large-en-v1.5 (1024-dim), etc.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_MODEL_DIMENSION=384
EMBEDDING_BATCH_SIZE=50

# ── Scheduler ────────────────────────────────────────────────
NEWS_INGESTION_INTERVAL_HOURS=2
NEWS_OVERLAP_WINDOW_MINUTES=30
NEWS_MAX_ARTICLE_AGE_DAYS=30
NEWS_ADVISORY_LOCK_KEY=487219
NEWS_COLLECTOR_TIMEOUT_SECONDS=15

# ── Rate Limits ───────────────────────────────────────────────
MARKETAUX_RATE_LIMIT_PER_DAY=100
FINNHUB_RATE_LIMIT_PER_MINUTE=60
NEWSDATA_RATE_LIMIT_PER_DAY=200
